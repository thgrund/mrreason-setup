cabal-version:      2.2
name:               MrReason
version:            0.1.0.0
license:            BSD-3-Clause
license-file:       LICENSE
copyright:          2025 Thomas Grund
maintainer:         info@mrreason.org
author:             Thomas Grund
homepage:           mrreason.org
category:           Web
build-type:         Simple
extra-source-files:
    README.md
    CHANGELOG.md

source-repository head
    type:     git
    location: https://github.com/githubuser/MrReason

library
    exposed-modules:
        Sound.MrReason.Numeral
        Sound.MrReason.Setup
        Sound.MrReason.Sheet
        Sound.Tidal.MIDI
        Sound.MrReason.OrbitConfigParser
        Sound.MrReason.SongConfigParser

    hs-source-dirs:   src
    default-language: Haskell2010
    ghc-options:
        -Wall -Wcompat -Widentities -Wincomplete-record-updates
        -Wincomplete-uni-patterns -Wmissing-export-lists
        -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints

    build-depends:
        base >=4.7 && <5,
        containers <0.7,
        event-list >=0.1.2,
        tidal >=1.10.0,
        tidal-core >=1.10.0,
        midi >=0.2.2.4,
        aeson >=2.1.2.1,
        split >=0.2.5,
        bytestring >=0.11.5.3,
        parsec >= 3.1.16.1

test-suite MrReason-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    other-modules:
        Sound.Tidal.MIDISpec
        Sound.MrReason.SetupSpec
        Sound.TestUtils
        Sound.MrReason.ChordsSpec

    default-language: Haskell2010
    ghc-options:
        -Wall -Wcompat -Widentities -Wincomplete-record-updates
        -Wincomplete-uni-patterns -Wmissing-export-lists
        -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
        -threaded -rtsopts -with-rtsopts=-N

    build-depends:
        base,
        MrReason,
        hspec,
        QuickCheck,
        tidal >=1.9.5,
        tidal-core >=1.9.5,
        containers <0.7

